# Dependencies
node_modules/

# Builds
dist/
build/
*.apk
*.aab
app/android/app/build/
app/.expo/

# Env & secrets — never committed
.env
.env.*
!.env.example
*.pem
*.keystore
*.jks
credentials.json

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
!infra/terraform/example.tfvars
infra/terraform/.terraform.lock.hcl
# Plan files embed account IDs, ARNs, operator IPs and public keys
infra/terraform/tfplan
infra/terraform/*.tfplan

# Logs & OS noise
*.log
.DS_Store

# Test artifacts
coverage/
loadtest/results/*.json

# Agent tool config, not part of the deliverable
.claude/
