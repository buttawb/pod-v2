# Rolls the seeded demo round into the current day. Paired with
# pod-demo-roll.timer. Install both with:
#
#   sudo cp infra/systemd/pod-demo-roll.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pod-demo-roll.timer
#
# The round is selected by created_at >= date_trunc('day', now()), so a seeded
# demo silently expires at UTC midnight and every driver login opens on an empty
# day. This keeps it alive through the review window.
#
# It takes the connection string from the deployed .env rather than naming a
# host of its own. There is then one place that decides which database this
# system talks to, and a roll can never end up succeeding, exit code 0, against
# a database nobody reads. A silent success is the worst failure available here.

[Unit]
Description=Roll the seeded PoD demo round into the current day
Documentation=file:/home/ec2-user/pod-v2/backend/scripts/roll-demo-route.sql
# Only Docker is required. The roll is a database write and nothing else, so it
# does not care whether the API containers are up: the backends read the
# shifted rows whenever they next query, there is no cache to invalidate.
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# `-f docker-compose.prod.yml` and `--env-file .env` below are relative, and
# the compose project name is derived from this directory. Both depend on
# landing here, which is also what puts the run on the same compose network as
# the existing containers.
WorkingDirectory=/home/ec2-user/pod-v2

# deploy.sh renders .env, so reading the connection string back out of it means
# this timer always points at the database the last deploy configured. There is
# no second place to remember to update.
#
# Deliberately no leading dash on the path: if .env is missing, fail loudly.
# The alternative is an empty DATABASE_OWNER_URL, psql falling through to its
# own libpq defaults, and a roll landing somewhere nobody chose.
EnvironmentFile=/home/ec2-user/pod-v2/.env

# psql comes out of the postgres:16-alpine image, matching the server major
# version. It is a plain docker run rather than a compose service because the
# deployed stack has no database container to borrow a client from.
#
#   --rm      oneshot, leave no stopped container behind each night
#   -i        the SQL is mounted, but psql still wants a usable stdin
#   --volume  mount the SQL that this deploy shipped, read-only. The repo copy
#             under backend/scripts is rsynced on every deploy, so it cannot
#             drift the way a hand-placed copy in the home directory would.
#
# DATABASE_OWNER_URL, not DATABASE_URL: the runtime role is held to append-only
# grants and is not the right identity for a maintenance UPDATE.
#
# ${DATABASE_OWNER_URL} is deliberately unquoted. systemd expands the ${...}
# form into exactly one argument, whitespace and all, which is the guarantee
# wanted here. Shell-style double quotes would not add safety, only doubt about
# whether expansion still happens inside them.
ExecStart=/usr/bin/docker run --rm -i --env PGSSLMODE=require \
    --volume /home/ec2-user/pod-v2/backend/scripts/roll-demo-route.sql:/roll-demo-route.sql:ro \
    postgres:16-alpine psql ${DATABASE_OWNER_URL} --set=ON_ERROR_STOP=1 --quiet --file=/roll-demo-route.sql

[Install]
WantedBy=multi-user.target
