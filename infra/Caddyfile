{$DOMAIN} {
	encode gzip

	# API + SSE: round-robin across both backend instances.
	# flush_interval -1 disables response buffering so SSE events stream.
	handle /api/* {
		reverse_proxy backend-1:3000 backend-2:3000 {
			lb_policy round_robin
			flush_interval -1
			health_uri /api/health
			health_interval 10s
		}
	}

	handle /health {
		reverse_proxy backend-1:3000 backend-2:3000
	}

	# Privacy policy, at a clean public path because it is what the Google
	# Play listing links to. Play re-checks the URL after launch and enforces
	# against apps whose policy stops resolving, so it must not fall through
	# to the SPA below, which would answer with the dashboard's login.
	# A named matcher, because `handle` takes exactly one matcher token.
	@privacy path /privacy /privacy/
	handle @privacy {
		rewrite * /api/privacy
		reverse_proxy backend-1:3000 backend-2:3000 {
			lb_policy round_robin
			health_uri /api/health
			health_interval 10s
		}
	}

	# Office dashboard: static SPA build.
	handle {
		root * /srv/dashboard
		try_files {path} /index.html
		file_server
	}
}
