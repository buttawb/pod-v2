{$DOMAIN} {
	encode gzip

	# API + SSE: round-robin across both backend instances.
	# flush_interval -1 disables response buffering so SSE events stream.
	handle /api/* {
		reverse_proxy backend-1:3000 backend-2:3000 {
			lb_policy round_robin
			flush_interval -1
			health_uri /api/health
			health_interval 10s
		}
	}

	handle /health {
		reverse_proxy backend-1:3000 backend-2:3000
	}

	# Privacy policy, at a clean public path because it is what the Google
	# Play listing links to. Play re-checks the URL after launch and enforces
	# against apps whose policy stops resolving, so it gets its own route
	# rather than depending on anything below it.
	# A named matcher, because `handle` takes exactly one matcher token.
	@privacy path /privacy /privacy/
	handle @privacy {
		rewrite * /api/privacy
		reverse_proxy backend-1:3000 backend-2:3000 {
			lb_policy round_robin
			health_uri /api/health
			health_interval 10s
		}
	}

	# There is no web front end, by design: the office is served by read APIs.
	# So the root of this host is the API reference. Anyone who lands here gets
	# the contract rather than a login screen they have no account for.
	# `*` is required: Caddy reads a leading-slash first argument as a path
	# matcher, so `redir /api/docs permanent` silently means "match /api/docs,
	# redirect to the literal string permanent" and everything else falls
	# through to an empty 200.
	handle {
		redir * /api/docs permanent
	}
}
