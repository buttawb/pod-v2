# --- Core ---
NODE_ENV=development
PORT=3000
INSTANCE_ID=backend-local

# Runtime role. In prod this is pod_app (append-only grants); migrations run
# separately with the owner role.
DATABASE_URL=postgres://pod:pod_dev_only@localhost:5433/pod

# --- Auth ---
# Any random string of 32+ chars. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=14

# --- AWS (prod uses the EC2 instance role; no keys in env, ever) ---
AWS_REGION=ap-southeast-1
S3_BUCKET=pod-evidence-local
# Uncomment for localstack:
# S3_ENDPOINT=http://localhost:4566

# --- AI (Bedrock) ---
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
AI_TIMEOUT_MS=3000
AI_ENABLED=true

# --- Migration/rollout levers ---
DUAL_WRITE_PODS=true
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=2.0.0
BLOCKED_APP_VERSIONS=
# APK_DOWNLOAD_URL=https://example.com/pod-v2.apk

# --- Media ---
PRESIGN_PUT_TTL_SEC=900
PRESIGN_GET_TTL_SEC=300
