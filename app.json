{
  "expo": {
    "name": "PoD v2",
    "slug": "pod-v2",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.podv2.driver",
      "versionCode": 200,
      "adaptiveIcon": {
        "backgroundColor": "#0B5FD6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-dev-client",
      "@maplibre/maplibre-react-native",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan parcel barcodes and photograph delivery evidence."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Photograph delivery evidence at the doorstep."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Record where each delivery attempt was made."
        }
      ]
    ]
  }
}
